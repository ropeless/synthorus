{
  "parameters": {
    "number_of_patients": 10,
    "time_limit": 100
  },
  "entities": {
    "patient": {
      "sampler": "patient",
      "id_field_name": "_id_",
      "count_field_name": "_count_",
      "foreign_key_fields": [],
      "fields": {
        "patient_age": {
          "type": "sample",
          "rv_name": "patient_age"
        }
      },
      "cardinality": [
        {
          "type": "variable",
          "field": "_count_",
          "op": ">=",
          "limit_field": "number_of_patients"
        }
      ]
    },
    "event": {
      "sampler": "event",
      "id_field_name": "_id_",
      "count_field_name": "_count_",
      "foreign_key_fields": [
        {
          "foreign_key_field_name": "_patient__id_",
          "foreign_entity": "patient"
        }
      ],
      "fields": {
        "event_type": {
          "type": "sample",
          "rv_name": "event_type"
        },
        "event_duration": {
          "type": "sample",
          "rv_name": "event_duration"
        },
        "event_duration_since_last": {
          "type": "sample",
          "rv_name": "event_duration_since_last"
        },
        "time": {
          "type": "sum",
          "initial_value": 0,
          "inputs": [
            "event_duration_since_last",
            "event_duration"
          ],
          "add_self": true
        }
      },
      "cardinality": [
        {
          "type": "variable",
          "field": "time",
          "op": ">=",
          "limit_field": "time_limit"
        },
        {
          "type": "states",
          "field": "event_type",
          "states": [
            "DEATH"
          ]
        }
      ]
    }
  }
}
